@page
@model Ware_HW3.Pages.Products.IndexModel

<h1>Products</h1>

<div class="row">

	@foreach (var product in Model.ProductList)
	{
		<div class="col-md-3 mb-3">
			<div class="card">
				<img src="~/images/@product.prodimage" class="card-img-top" style="height:200px" />

				<div class="card-body">
					<h5 class="card-title">@product.ProductName</h5>

					<p class="card-text">

						Target Level: @product.TargetLevel

					</p>

				</div>

				<div>

					<a asp-page="/Products/ProductDetails" asp-route-productID="@product.ProductID" class="btn btn-primary">
						View Product Information
					</a>

				</div>

			</div>

		</div>
	}


</div>
